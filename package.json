{
  "name": "execution-governance-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Fail-closed pre-execution authorization gate for AI agents. SDK plus MCP proxy. Signed receipt per action.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/gate",
    "packages/mcp-gate",
    "examples/injection-demo",
    "examples/quickstart"
  ],
  "scripts": {
    "build": "tsc -b",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint . && prettier --check \"**/*.{ts,js,mjs,json,md,yaml,yml}\"",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yaml,yml}\"",
    "demo": "npm run build && node examples/injection-demo/demo.mjs",
    "test:e2e": "npm run build && playwright test",
    "gen:verify-page": "npm run build && node scripts/gen-verify-page.mjs",
    "gen:vectors": "npm run build && tsc -p scripts/tsconfig.json && node node_modules/.cache/eg-scripts/gen-vectors-doc.js && prettier --log-level warn --write docs/VECTORS.md README.md"
  },
  "devDependencies": {
    "@noble/ed25519": "^3.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
